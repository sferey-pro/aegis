# Aegis Environment Variables

# The port on which the Aegis server listens (default: 3001)
AEGIS_PORT=3001

# The host to bind to. Set to 127.0.0.1 for local use, or 0.0.0.0 for external access
HOST=127.0.0.1

# Path to the SQLite database file (default: audit.sqlite)
DB_PATH=audit.sqlite

# Path to the advisory database (default: <DB_PATH>-advisories.sqlite).
#
# A second file on purpose. It holds everything about talking to GitHub — the
# advisory cache, the GHSA key, the rate-limit state — so that resetting the
# configuration can be the deletion of the main file, with no list of tables to
# keep in sync. Deleting this file only costs a rebuild of the cache.
# ADVISORY_DB_PATH=audit-advisories.sqlite

# Token used for ingesting audit reports from remote runners
AEGIS_INGEST_TOKEN=your_secure_random_token_here

# Allowed root directories for project auditing (comma-separated absolute paths).
#
# REQUIRED. Fails closed: with this variable unset, no path is accepted and every
# project creation, git operation and audit is refused with 403. Git runs the
# hooks of the repository it visits, so an unset allowlist used to mean any path
# on the host was executable.
#
# Comparison happens at the path separator: /srv/app-bis is NOT under /srv/app.
# To deliberately allow the whole filesystem, set AEGIS_ALLOWED_ROOTS=/
AEGIS_ALLOWED_ROOTS=/home/youruser/projects,/var/www

# GitHub Personal Access Token for fetching advisory details
GITHUB_TOKEN=ghp_your_github_token_here
