# Aegis Environment Variables

# The port on which the Aegis server listens (default: 3001)
AEGIS_PORT=3001

# The host to bind to. Set to 127.0.0.1 for local use, or 0.0.0.0 for external access
HOST=127.0.0.1

# Path to the SQLite database file (default: audit.sqlite)
DB_PATH=audit.sqlite

# Path to the advisory database (default: <DB_PATH>-advisories.sqlite).
#
# A second file on purpose. It holds everything about talking to GitHub — the
# advisory cache, the GHSA key, the rate-limit state — so that resetting the
# configuration can be the deletion of the main file, with no list of tables to
# keep in sync. Deleting this file only costs a rebuild of the cache.
# ADVISORY_DB_PATH=audit-advisories.sqlite

# Token used for ingesting audit reports from remote runners
AEGIS_INGEST_TOKEN=your_secure_random_token_here

# Allowed root directories for project auditing (comma-separated absolute paths).
#
# REQUIRED. Fails closed: with this variable unset, no path is accepted and every
# project creation, git operation and audit is refused with 403. Git runs the
# hooks of the repository it visits, so an unset allowlist used to mean any path
# on the host was executable.
#
# Comparison happens at the path separator: /srv/app-bis is NOT under /srv/app.
# To deliberately allow the whole filesystem, set AEGIS_ALLOWED_ROOTS=/
AEGIS_ALLOWED_ROOTS=/home/youruser/projects,/var/www

# GitHub Personal Access Token for fetching advisory details.
#
# Optional. Without it the GitHub API allows 60 requests/hour instead of 5000,
# and the advisory refresh pass throttles itself accordingly.
#
# The settings screen can hold this value instead; the database wins, this
# variable is the fallback. Handy for a container or a CI runner, where writing
# the secret into the database is undesirable.
GITHUB_TOKEN=ghp_your_github_token_here

# Jira API token, used with JIRA_USER for the `Authorization: Basic` header when
# creating remediation tickets (CONTEXT.md §8).
#
# Optional, and same rule as GITHUB_TOKEN: the settings screen wins, this
# variable is the fallback. Only the *secret* comes from the environment — the
# base URL, the user, the project key and the issue type are not secrets and stay
# in the settings screen, where JIRA_BASE_URL is validated as https on write and
# re-validated at the point of use (§15).
#
# Generate one at id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_KEY=your_jira_api_token_here

# Mirror the live console to the server's standard output.
#
# The SSE stream only reaches the browser: in development the `make dev` terminal
# showed nothing of the outgoing calls — not Jira, not GitHub, not the
# subprocesses. One line per step, plus its output indented.
#
# **Filtered by label**, because logging everything drowns what you came for: a
# single getGitInfo emits 17 lines — 289 for a fleet of seventeen — and every one
# of them is a synchronous write on the path of all subprocesses.
#
#   (unset)      `jira` outside production, nothing under test
#   jira,audit   explicit list
#   all          every family, for a one-off debugging session
#   0            silent
#
# Only `jira` prints its full payload: that is the point — reading what leaves the
# process before believing it. Other families print failures only.
#
# Independent of DISABLE_CONSOLE, which turns off the SSE broadcast to the
# browser — a different concern.
AEGIS_CONSOLE_STDOUT=jira

# --- Backup & restore (CONTEXT.md §12) ---
# Root backup directory. SQLite snapshots live in <BACKUP_DIR>/db.
BACKUP_DIR=backups
# How many dated snapshots the rotation keeps. `pre-restore-*.sqlite` safety nets
# are excluded: they are recovery points, not periodic backups.
BACKUP_DB_KEEP=14

# --- Rafraîchissement automatique des avis GHSA ---
# Intervalle en minutes entre deux passes d'enrichissement (défaut 360, soit 6 h).
# 0 désactive entièrement la tâche de fond. Une valeur illisible retombe sur le
# défaut plutôt que de couper la surveillance en silence.
#
# Chaque passe saute les avis déjà en cache et s'arrête au premier quota atteint,
# en reprenant là où elle s'était interrompue. Sans GITHUB_TOKEN le quota est de
# 60 requêtes/heure : la passe s'autolimite.
ADVISORY_SYNC_INTERVAL_MIN=360
