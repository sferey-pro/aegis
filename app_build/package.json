{
	"name": "aegis",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"start": "NODE_ENV=production bun src/index.ts",
		"build": "bun run build.ts",
		"test": "bun run test:ui && bun run test:api",
		"lint": "biome check src/ --error-on-warnings",
		"typecheck": "tsc --noEmit",
		"jira:types": "bunx openapi-typescript ../docs/references/swagger-v3.v3.json -o src/lib/jira/schema.d.ts",
		"check": "bun run typecheck && bun run test",
		"test:ui": "bun test src/components src/pages src/App.test.tsx",
		"test:api": "AEGIS_TEST_NO_DOM=1 bun test src/db src/lib src/routes src/test src/index.test.ts",
		"coverage": "bun run coverage:ui && bun run coverage:api",
		"coverage:ui": "bun test --coverage src/components src/pages src/App.test.tsx",
		"coverage:api": "AEGIS_TEST_NO_DOM=1 bun test --coverage src/db src/lib src/routes src/test src/index.test.ts"
	},
	"dependencies": {
		"@atlaskit/adf-schema": "^57.0.14",
		"@atlaskit/adf-utils": "^20.5.0",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.3",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1",
		"radix-ui": "^1.6.7",
		"react": "^19",
		"react-dom": "^19",
		"react-router-dom": "^7.18.2",
		"recharts": "3.8.0",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@happy-dom/global-registrator": "^20.11.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"happy-dom": "^20.11.6",
		"marked": "^18.0.7",
		"tailwindcss": "^4.1.11",
		"typescript": "^7.0.2"
	}
}
